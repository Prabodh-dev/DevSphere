# Copy to .env and fill in. Never commit the real file.

# --- Server ---
PORT=5000
# Number of reverse proxies in front of the app (used to read client addresses
# for rate limiting). Leave empty when not behind a proxy.
TRUST_PROXY=
# Comma separated browser origins allowed to call the API, e.g. https://app.example.com
# Leave empty to allow none.
CORS_ORIGINS=

# --- Required ---
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/devsphere
# At least 32 random characters
JWT_SECRET=

# --- Redis (optional, online presence) ---
REDIS_URL=

# --- Rate limits (optional, requests per window) ---
# General limit per 15 minutes for /api
RATE_LIMIT_MAX=300
# Login and register, per 15 minutes
AUTH_RATE_LIMIT_MAX=10
# Public snippet highlighter, per minute
HIGHLIGHT_RATE_LIMIT_MAX=30

# --- Uploads (S3) ---
# Use a private bucket (block public access). Files are served through
# short-lived signed links.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AVATAR_BUCKET=
# Lifetime of signed links in seconds (default 300, maximum 3600)
MEDIA_URL_TTL_SECONDS=300
