# Copy to .env and fill in. Never commit the real file.

# --- Server ---
# development, test or production
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app, so rate limiting sees real
# client addresses. 0 (or empty) when not behind a proxy.
TRUST_PROXY=0
# Comma separated browser origins allowed to call the API, e.g. https://app.example.com
# Leave empty to allow none.
CORS_ORIGINS=

# --- Required ---
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/devsphere
# At least 32 random characters
JWT_SECRET=

# --- Sessions ---
# Lifetime of access tokens: 30s, 15m, 2h or 1d (default 15m)
ACCESS_TOKEN_TTL=15m
# Lifetime of refresh tokens in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30
# Set to true when the API is served over HTTPS so the refresh cookie is Secure
COOKIE_SECURE=false

# Build missing database indexes at startup (true/false). Defaults to true,
# except when NODE_ENV=production, where `pnpm db:indexes` is used instead.
MONGO_AUTO_INDEX=

# Serve the API docs page (/api/v1/docs) and spec (/api/v1/openapi.json).
# Defaults to true, except when NODE_ENV=production.
DOCS_ENABLED=

# --- Logging and metrics ---
# fatal, error, warn, info, debug, trace or silent (default info)
LOG_LEVEL=
# Human readable log output instead of JSON (true/false, default false)
LOG_PRETTY=
# Serve Prometheus metrics at /metrics (true/false, default false)
METRICS_ENABLED=
# When set, /metrics needs "Authorization: Bearer <this value>"
METRICS_TOKEN=

# --- Redis (optional) ---
# Needed to run more than one app instance: it shares socket rooms and events,
# rate limits, presence and live code state between them. One instance works
# without it.
REDIS_URL=
# Prefix for the keys this app writes (useful when sharing one Redis)
REDIS_KEY_PREFIX=

# --- Live code ---
# Milliseconds a live code edit waits for more edits before it is saved to
# MongoDB (default 2000). Edits are also saved when a user disconnects and
# when the server shuts down.
LIVE_CODE_FLUSH_MS=2000

# --- Rate limits (optional, requests per window) ---
# General limit per 15 minutes for /api
RATE_LIMIT_MAX=300
# Login and register, per 15 minutes
AUTH_RATE_LIMIT_MAX=10
# Token refresh, per 15 minutes
REFRESH_RATE_LIMIT_MAX=60
# Public snippet highlighter, per minute
HIGHLIGHT_RATE_LIMIT_MAX=30

# --- Uploads (S3) ---
# Use a private bucket (block public access). Files are served through
# short-lived signed links.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AVATAR_BUCKET=
# Lifetime of signed links in seconds (default 300, maximum 3600)
MEDIA_URL_TTL_SECONDS=300
